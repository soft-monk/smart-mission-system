@echo off
REM ============================================================================
REM  mapApp - machine-local overrides   (git-ignored)
REM
REM  HOW TO USE
REM    1) copy this file to:  scripts\env.local.bat
REM    2) uncomment / edit only what this machine needs
REM
REM  Every machine keeps its own env.local.bat, so the shared scripts under
REM  scripts\ and backend\ never need to be edited again.
REM ============================================================================

REM --- vcpkg: your own vcpkg checkout (dir holding scripts\buildsystems\vcpkg.cmake)
REM set "MAPAPP_VCPKG_ROOT=D:\dev\vcpkg"

REM --- CMake: pin an exact cmake.exe (otherwise PATH / Visual Studio is auto-detected)
REM set "MAPAPP_CMAKE=C:\Program Files\CMake\bin\cmake.exe"

REM --- CMake generator: only needed when auto-detection picks the wrong VS
REM     examples: "Visual Studio 17 2022"  |  "Ninja"
REM set "MAPAPP_CMAKE_GENERATOR=Visual Studio 17 2022"

REM --- Python: pin the interpreter used to build ai\.venv
REM     examples: "py -3.12"  |  "C:\Python312\python.exe"
REM set "MAPAPP_PYTHON=py -3.12"

REM --- Node: pin node.exe when it is not on PATH
REM set "MAPAPP_NODE=C:\Program Files\nodejs\node.exe"

REM --- ports: change when 8080 / 8090 are already taken on this machine
REM set "MAPAPP_HTTP_PORT=18080"
REM set "MAPAPP_AI_PORT=18090"

REM --- proxy: only for machines that need one for vcpkg / pip / npm downloads
REM     (the scripts clear the duplicated system proxy variables on purpose)
REM set "MAPAPP_HTTPS_PROXY=http://127.0.0.1:7897"
REM set "MAPAPP_HTTP_PROXY=http://127.0.0.1:7897"
